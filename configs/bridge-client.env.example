# NATS connection
NATS_URL=nats://your-nats-server:4222
NATS_JWT=eyJ0eXAi...your-jwt-here
NATS_SEED=SUAM...your-seed-here
KV_BUCKET=bridge-sessions

# Client configuration
CLIENT_ID=my-laptop

# Server data port connection
SERVER_HOST=your-server.example.com
DATA_PORT=9443

# Local service to forward to
LOCAL_TARGET=localhost:443
