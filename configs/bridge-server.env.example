# NATS connection
NATS_URL=nats://your-nats-server:4222
NATS_JWT=eyJ0eXAi...your-jwt-here
NATS_SEED=SUAM...your-seed-here
KV_BUCKET=bridge-sessions

# Server configuration
LISTEN_ADDR=0.0.0.0
PUBLIC_PORT=443
DATA_PORT=9443

# Allowed client identifiers (comma-separated). Any listed client may
# connect, but only one at a time holds the bridge; others are rejected
# until the active client disconnects. CLIENT_ID (singular) is still
# accepted for backward compatibility.
CLIENT_IDS=my-laptop,my-desktop
