# NATS connection
NATS_URL=nats://your-nats-server:4222
NATS_JWT=eyJ0eXAi...your-jwt-here
NATS_SEED=SUAM...your-seed-here
KV_BUCKET=bridge-sessions

# Server configuration
LISTEN_ADDR=0.0.0.0
PUBLIC_PORT=443
DATA_PORT=9443

# Client identifier (must match the client's CLIENT_ID)
CLIENT_ID=my-laptop
